# Database Config
DATABASE_URL="postgresql://username:password@localhost:5432/kaampay?schema=public"

# Better Auth — CHANGE this to a long random string in production
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="http://localhost:5000"

# Backend
PORT=5000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"

# Social Login OAuth Credentials (Replace these in production)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Cloudinary Config
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Redis (Local Docker or Aiven Redis)
REDIS_URL="redis://:kaampay_redis_dev@localhost:6379"

# Aiven Kafka (SSL + SASL/PLAIN)
KAFKA_BROKERS="your-aiven-host:port"
KAFKA_USERNAME="avnadmin"
KAFKA_PASSWORD="your-kafka-password"
KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

