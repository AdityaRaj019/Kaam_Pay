## Phase 5 — Backend: File Upload API (Cloudinary + Multer)

**New file:** `backend/src/middleware/upload.ts`

```typescript
// Multer handles the file upload. Multer-storage-cloudinary pipes it directly to Cloudinary.
// This means files are NEVER written to your disk — they go straight to the cloud.

import multer from 'multer';
import { CloudinaryStorage } from 'multer-storage-cloudinary';
import cloudinary from '../config/cloudinary';

// Allowed file types
const ALLOWED_FORMATS = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'pdf', 'mp4', 'mov', 'csv', 'xlsx'];
const MAX_FILE_SIZE_BYTES = 25 * 1024 * 1024; // 25MB per file
const MAX_FILES = 5; // Max 5 files per message

const storage = new CloudinaryStorage({
  cloudinary,
  params: async (_req, file) => {
    // Detect resource type for Cloudinary
    const isVideo = file.mimetype.startsWith('video/');
    const isImage = file.mimetype.startsWith('image/');

    return {
      folder: 'kaampay/chat-attachments',
      resource_type: isVideo ? 'video' : isImage ? 'image' : 'raw',
      // raw = PDFs, CSVs, etc.
      allowed_formats: ALLOWED_FORMATS,
      // Use original filename as public_id for easier identification
      public_id: `${Date.now()}-${file.originalname.replace(/\s+/g, '_')}`,
    };
  },
});

export const chatUpload = multer({
  storage,
  limits: { fileSize: MAX_FILE_SIZE_BYTES, files: MAX_FILES },
  fileFilter: (_req, file, cb) => {
    const ext = file.originalname.split('.').pop()?.toLowerCase() ?? '';
    if (!ALLOWED_FORMATS.includes(ext)) {
      return cb(new Error(`File type .${ext} is not allowed`));
    }
    cb(null, true);
  },
});
```

