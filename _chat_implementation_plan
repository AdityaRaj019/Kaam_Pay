## Phase 4 — Backend: Socket.io Server with Redis Adapter

**New file:** `backend/src/socket/chat.socket.ts`

```typescript
// This is the main Socket.io server logic.
// Think of it as the receptionist that manages who is in which room.

import { Server as HttpServer } from 'http';
import { Server as SocketServer } from 'socket.io';
import { createAdapter } from '@socket.io/redis-adapter';
import { pubClient, subClient } from '../config/redis';
import { producer, CHAT_TOPIC, NOTIFICATION_TOPIC } from '../config/kafka';
import { prisma } from '../config/database';

// Map to track which socket belongs to which user
const onlineUsers = new Map<string, string>(); // socketId → userId

export async function initSocketServer(httpServer: HttpServer): Promise<SocketServer> {
  const io = new SocketServer(httpServer, {
    cors: {
      origin: process.env.CLIENT_URL ?? 'http://localhost:3000',
      credentials: true,
    },
  });

  // Connect Redis adapter so Socket.io state is shared across instances
  await pubClient.connect().catch(() => {}); // ioredis auto-connects, ignore error
  await subClient.connect().catch(() => {});
  io.adapter(createAdapter(pubClient, subClient));

  io.on('connection', (socket) => {
    console.log(`[Socket] Connected: ${socket.id}`);

    // ── Step 1: User identifies themselves ────────────────────────────────────
    // Frontend sends { userId } immediately after connecting
    socket.on('authenticate', async ({ userId }: { userId: string }) => {
      if (!userId) return;

      onlineUsers.set(socket.id, userId);

      // Join a personal room for receiving notifications
      await socket.join(`user_${userId}`);

      // Tell everyone this user is online (for presence dots)
      socket.broadcast.emit('user_online', { userId });

      console.log(`[Socket] User ${userId} authenticated on socket ${socket.id}`);
    });

    // ── Step 2: User joins an order chat room ─────────────────────────────────
    // Frontend sends { orderId } when opening the chat window
    socket.on('join_room', async ({ orderId }: { orderId: string }) => {
      const userId = onlineUsers.get(socket.id);
      if (!userId) return socket.emit('error', { message: 'Not authenticated' });

      // Security: verify user is a party in this order
      const order = await prisma.order.findFirst({
        where: {
          id: orderId,
          OR: [{ clientId: userId }, { freelancerId: userId }],
        },
        include: { chatRoom: true },
      });

      if (!order) return socket.emit('error', { message: 'Access denied to this chat' });

      const roomName = `order_${order.chatRoom?.id ?? orderId}`;
      await socket.join(roomName);

      // Tell the other party that this user is now viewing the chat
      socket.to(roomName).emit('user_joined_chat', { userId });

      console.log(`[Socket] User ${userId} joined room ${roomName}`);
    });

    // ── Step 3: User sends a message ─────────────────────────────────────────
    socket.on(
      'send_message',
      async ({
        orderId,
        text,
        attachments,
      }: {
        orderId: string;
        text?: string;
        attachments?: Array<{ url: string; publicId: string; fileType: string; fileName: string; fileSize: number }>;
      }) => {
        const userId = onlineUsers.get(socket.id);
        if (!userId) return;

        // Find the ChatRoom for this order
        const chatRoom = await prisma.chatRoom.findUnique({ where: { orderId } });
        if (!chatRoom) return socket.emit('error', { message: 'Chat room not found' });

        if (!text && (!attachments || attachments.length === 0)) {
          return socket.emit('error', { message: 'Message cannot be empty' });
        }

        // Push to Kafka — the consumer will save to DB and broadcast
        await producer.send({
          topic: CHAT_TOPIC,
          messages: [
            {
              key: chatRoom.id,
              value: JSON.stringify({
                chatRoomId: chatRoom.id,
                senderId: userId,
                text,
                attachments,
              }),
            },
          ],
        });
      },
    );

    // ── Step 4: Typing indicator (debounced on the frontend) ──────────────────
    socket.on('typing', ({ orderId, isTyping }: { orderId: string; isTyping: boolean }) => {
      const userId = onlineUsers.get(socket.id);
      if (!userId) return;

      // Broadcast to everyone else in the room (not back to the sender)
      socket.to(`order_${orderId}`).emit('user_typing', { userId, isTyping });
    });

    // ── Step 5: User disconnects ─────────────────────────────────────────────
    socket.on('disconnect', () => {
      const userId = onlineUsers.get(socket.id);
      if (userId) {
        onlineUsers.delete(socket.id);
        // Tell others this user went offline
        socket.broadcast.emit('user_offline', { userId });
        console.log(`[Socket] User ${userId} disconnected`);
      }
    });
  });

  return io;
}

// Helper: send a notification through Kafka (call this from your order controllers)
export async function sendNotification(userId: string, type: string, message: string): Promise<void> {
  await producer.send({
    topic: NOTIFICATION_TOPIC,
    messages: [{ key: userId, value: JSON.stringify({ userId, type, message }) }],
  });
}
```

