## Phase 3 — Backend: Kafka Consumer (Message Processor)

**New file:** `backend/src/services/chat.consumer.ts`

This is the "worker" that reads from Kafka and saves messages to the database, then puts them into the Socket.io delivery pipeline.

```typescript
// This file runs as a long-lived background process.
// It listens to Kafka for chat messages, saves them, and delivers via Socket.io.

import { consumer, CHAT_TOPIC, NOTIFICATION_TOPIC } from '../config/kafka';
import { prisma } from '../config/database';
import { Server as SocketServer } from 'socket.io';

// We pass the io server in so we can emit events from here
export async function startChatConsumer(io: SocketServer): Promise<void> {
  await consumer.connect();
  await consumer.subscribe({ topics: [CHAT_TOPIC, NOTIFICATION_TOPIC], fromBeginning: false });

  await consumer.run({
    eachMessage: async ({ topic, message }) => {
      if (!message.value) return;

      try {
        const payload = JSON.parse(message.value.toString()) as Record<string, unknown>;

        if (topic === CHAT_TOPIC) {
          await processChatMessage(io, payload);
        } else if (topic === NOTIFICATION_TOPIC) {
          await processNotification(io, payload);
        }
      } catch (err) {
        // Log error but do NOT crash the consumer; just skip the bad message
        console.error(`[Consumer] Failed to process message on topic ${topic}:`, err);
      }
    },
  });
}

// ── Saves a chat message to DB and broadcasts it ──────────────────────────────

async function processChatMessage(
  io: SocketServer,
  payload: Record<string, unknown>,
): Promise<void> {
  const { chatRoomId, senderId, text, attachments } = payload as {
    chatRoomId: string;
    senderId: string;
    text?: string;
    attachments?: Array<{ url: string; publicId: string; fileType: string; fileName: string; fileSize: number }>;
  };

  // 1. Save to PostgreSQL
  const savedMessage = await prisma.message.create({
    data: {
      chatRoomId,
      senderId,
      text: text ?? null,
      attachments: attachments
        ? { create: attachments }
        : undefined,
    },
    include: {
      sender: { select: { id: true, name: true, image: true } },
      attachments: true,
    },
  });

  // 2. Broadcast to the room via Socket.io
  // The room name is "order_{orderId}" — only the two parties are in it
  const room = `order_${chatRoomId}`;
  io.to(room).emit('receive_message', savedMessage);
}

// ── Saves a notification to DB and pushes it to the target user ───────────────

async function processNotification(
  io: SocketServer,
  payload: Record<string, unknown>,
): Promise<void> {
  const { userId, type, message } = payload as {
    userId: string;
    type: string;
    message: string;
  };

  // 1. Save notification to DB
  const notification = await prisma.notification.create({
    data: { userId, type, message },
  });

  // 2. Push to that user's personal socket room (user_{userId})
  io.to(`user_${userId}`).emit('notification', notification);
}
```

