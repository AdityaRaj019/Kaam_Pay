import { Download, FileText, Film, File } from 'lucide-react';
import { Attachment } from '@/hooks/useChat';

interface AttachmentPreviewProps {
  attachment: Attachment;
}

export function AttachmentPreview({ attachment }: AttachmentPreviewProps) {
  const { url, fileType, fileName, fileSize } = attachment;
  const fileSizeKB = (fileSize / 1024).toFixed(1);

  if (fileType === 'image') {
    return (
      <a href={url} download={fileName} target="_blank" rel="noreferrer" className="block">
        {/* Image shown inline */}
        <img
          src={url}
          alt={fileName}
          className="max-w-xs max-h-64 rounded-lg object-cover cursor-pointer hover:opacity-90 transition-opacity"
          loading="lazy"
        />
        <p className="text-xs text-gray-500 mt-1 flex items-center gap-1">
          <Download className="w-3 h-3" /> {fileName} ({fileSizeKB} KB)
        </p>
      </a>
    );
  }

  if (fileType === 'video') {
    return (
      <div className="max-w-xs">
        <video controls className="rounded-lg w-full" preload="metadata">
          <source src={url} />
          Your browser does not support video.
        </video>
        <a
          href={url}
          download={fileName}
          className="text-xs text-indigo-600 hover:underline flex items-center gap-1 mt-1"
        >
          <Download className="w-3 h-3" /> Download {fileName}
        </a>
      </div>
    );
  }

  // PDF, CSV, or other — show a download card
  const Icon = fileType === 'pdf' ? FileText : fileType === 'csv' ? File : Film;

  return (
    <a
      href={url}
      download={fileName}
      target="_blank"
      rel="noreferrer"
      className="flex items-center gap-3 p-3 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors max-w-xs"
    >
