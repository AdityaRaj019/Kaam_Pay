import { Request, Response } from 'express';
import { prisma } from '../config/database';
import cloudinary from '../config/cloudinary';

// ── GET chat history ──────────────────────────────────────────────────────────

export async function getChatHistory(req: Request, res: Response): Promise<void> {
  const { orderId } = req.params;
  const userId = req.user?.id; // from your auth middleware

  // Security: user must be a party in this order
  const order = await prisma.order.findFirst({
    where: {
      id: orderId,
      OR: [{ clientId: userId }, { freelancerId: userId }],
    },
    include: { chatRoom: { include: { messages: { include: { sender: { select: { id: true, name: true, image: true } }, attachments: true }, orderBy: { createdAt: 'asc' } } } } },
  });

  if (!order || !order.chatRoom) {
    res.status(404).json({ success: false, error: { message: 'Chat not found' } });
    return;
  }

  res.json({ success: true, data: order.chatRoom.messages });
}

// ── POST upload files ─────────────────────────────────────────────────────────

export async function uploadChatFiles(req: Request, res: Response): Promise<void> {
  const files = req.files as Express.Multer.File[];

  if (!files || files.length === 0) {
    res.status(400).json({ success: false, error: { message: 'No files provided' } });
    return;
  }

  // Build the attachment metadata array
  const attachments = files.map((file) => {
    const cloudFile = file as Express.Multer.File & {
      path: string;           // Cloudinary URL
      filename: string;       // Cloudinary public_id
      mimetype: string;
      originalname: string;
      size: number;
    };

    // Determine file type category
    let fileType = 'other';
    if (cloudFile.mimetype.startsWith('image/')) fileType = 'image';
    else if (cloudFile.mimetype.startsWith('video/')) fileType = 'video';
    else if (cloudFile.mimetype === 'application/pdf') fileType = 'pdf';
    else if (cloudFile.mimetype.includes('csv') || cloudFile.mimetype.includes('excel')) fileType = 'csv';

    return {
      url: cloudFile.path,
      publicId: cloudFile.filename,
      fileType,
      fileName: cloudFile.originalname,
      fileSize: cloudFile.size,
    };
  });

  res.json({ success: true, data: attachments });
}
