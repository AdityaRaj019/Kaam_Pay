### 6.2 Create `hooks/useChat.ts`

```typescript
// This is the main hook for the chat window.
// It manages: message list, typing state, online presence, sending messages.

import { useState, useEffect, useCallback, useRef } from 'react';
import { useDebouncedCallback } from 'use-debounce';
import axios from 'axios';
import { getSocket } from '@/lib/socket';

export interface Attachment {
  url: string;
  publicId: string;
  fileType: 'image' | 'pdf' | 'video' | 'csv' | 'other';
  fileName: string;
  fileSize: number;
}

export interface ChatMessage {
  id: string;
  senderId: string;
  text: string | null;
  attachments: Attachment[];
  createdAt: string;
  sender: { id: string; name: string; image: string | null };
}

export function useChat(orderId: string, currentUserId: string) {
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [isOtherOnline, setIsOtherOnline] = useState(false);
  const [otherIsTyping, setOtherIsTyping] = useState(false);
  const [isLoading, setIsLoading] = useState(true);
  const socket = getSocket();

  // ── Load chat history on mount ─────────────────────────────────────────────
  useEffect(() => {
    async function loadHistory() {
      try {
        const { data } = await axios.get(`/api/v1/chat/order/${orderId}`);
        setMessages(data.data);
      } catch (err) {
        console.error('[Chat] Failed to load history:', err);
      } finally {
        setIsLoading(false);
      }
    }
    loadHistory();
  }, [orderId]);

  // ── Join room and listen for events ───────────────────────────────────────
  useEffect(() => {
    socket.emit('join_room', { orderId });

    // New message arrives
    socket.on('receive_message', (msg: ChatMessage) => {
      setMessages((prev) => [...prev, msg]);
    });

    // The other person came online / went offline
    socket.on('user_online', () => setIsOtherOnline(true));
    socket.on('user_offline', () => setIsOtherOnline(false));
    socket.on('user_joined_chat', () => setIsOtherOnline(true));

    // Typing indicator
    socket.on('user_typing', ({ userId, isTyping }: { userId: string; isTyping: boolean }) => {
      if (userId !== currentUserId) {
        setOtherIsTyping(isTyping);
      }
    });

    return () => {
      socket.off('receive_message');
      socket.off('user_online');
      socket.off('user_offline');
      socket.off('user_joined_chat');
      socket.off('user_typing');
    };
  }, [orderId, currentUserId, socket]);

  // ── Debounced typing emitter (300ms) ──────────────────────────────────────
  // Fires "stop typing" 1 second after user stops typing
  const emitStopTyping = useDebouncedCallback(() => {
    socket.emit('typing', { orderId, isTyping: false });
  }, 1000);

  const emitTyping = useCallback(() => {
    socket.emit('typing', { orderId, isTyping: true });
    emitStopTyping(); // schedule stop
  }, [orderId, socket, emitStopTyping]);

  // ── Send text message ─────────────────────────────────────────────────────
  const sendTextMessage = useCallback(
    (text: string) => {
      if (!text.trim()) return;
      socket.emit('send_message', { orderId, text: text.trim() });
    },
    [orderId, socket],
  );

  // ── Upload files then send message with attachments ───────────────────────
  const sendFilesMessage = useCallback(
    async (files: File[], text?: string) => {
      const formData = new FormData();
      files.forEach((f) => formData.append('files', f));

      const { data } = await axios.post('/api/v1/chat/upload', formData, {
        headers: { 'Content-Type': 'multipart/form-data' },
      });

      socket.emit('send_message', {
        orderId,
        text: text?.trim() || undefined,
        attachments: data.data,
      });
    },
    [orderId, socket],
  );

  return {
    messages,
    isOtherOnline,
    otherIsTyping,
    isLoading,
    sendTextMessage,
    sendFilesMessage,
    emitTyping,
  };
}
